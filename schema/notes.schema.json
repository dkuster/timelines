{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "En-tête YAML d'une note markdown",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "about": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      },
      "uniqueItems": true
    },
    "tags": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sourceList"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    }
  },
  "required": [
    "id",
    "about"
  ],
  "additionalProperties": false
}
